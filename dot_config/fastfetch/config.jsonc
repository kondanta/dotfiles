{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "color": {
            "keys": "38;2;226;52;42"
        },
        "separator": "  ",
        "percent": {
            "type": 9,
            "color": {
                "green": "38;2;127;191;106",
                "yellow": "38;2;217;164;65",
                "red": "38;2;226;52;42"
            }
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;226;52;42m──\u001b[0m \u001b[1;38;2;243;237;225mVITALS\u001b[0m \u001b[38;2;58;46;36m──────────────────────────\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "CPU     "
        },
        {
            "type": "gpu",
            "key": "GPU     ",
            "detectionMethod": "pci"
        },
        {
            "type": "memory",
            "key": "MEMORY  "
        },
        {
            "type": "disk",
            "key": "DISK    "
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;226;52;42m──\u001b[0m \u001b[1;38;2;243;237;225mSYSTEM\u001b[0m \u001b[38;2;58;46;36m──────────────────────────\u001b[0m"
        },
        {
            "type": "os",
            "key": "OS      "
        },
        {
            "type": "kernel",
            "key": "KERNEL  "
        },
        {
            "type": "command",
            "key": "WM      ",
            "text": "echo \"${XDG_CURRENT_DESKTOP:-Hyprland}\""
        },
        {
            "type": "shell",
            "key": "SHELL   "
        },
        {
            "type": "packages",
            "key": "PKGS    "
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;226;52;42m──\u001b[0m \u001b[1;38;2;243;237;225mSESSION\u001b[0m \u001b[38;2;58;46;36m─────────────────────────\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "UPTIME  "
        },
        {
            "type": "command",
            "key": "AGE     ",
            "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
        },
        {
            "type": "terminal",
            "key": "TERM    "
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        },
        "break"
    ]
}